{
  "name": "1lev1-shop-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A ready storefront for a 1lev1 rikma: catalog, variant picker, cart, Stripe Checkout, and the paid order reported from the server.",
  "scripts": {
    "dev": "vite dev --port 1111",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/adapter-netlify": "^5.2.4",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.20.5",
    "svelte": "^5.25.0",
    "svelte-check": "^4.1.5",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=20"
  }
}
