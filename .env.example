# ── 1lev1 ───────────────────────────────────────────────────────────────
# The rikma's API address — /api/v1/r/<slug or id>. Copy it from
# "Sales management → Connections" in your rikma.
LEV_RIKMA_URL=https://api.1lev1.com/api/v1/r/haohel

# Optional. A `products:read` key — only needed to show drafts while you
# build, or for a higher rate limit. The catalog is public without it.
LEV_READ_KEY=

# Required. A key with `orders:create` + `orders:read`. SERVER ONLY — it
# records sales that change the partners' balances. Never prefix it with
# PUBLIC_ and never put it in the page.
LEV_ORDERS_KEY=

# ── Payments ────────────────────────────────────────────────────────────
# Set Stripe, PayPal, or both — the cart shows a button for each one set up.

# ── Stripe ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
# From the webhook endpoint you add in Stripe for
# https://<your-site>/api/payments/webhook (events: checkout.session.completed,
# checkout.session.async_payment_succeeded).
STRIPE_WEBHOOK_SECRET=whsec_...

# ── PayPal (optional) ───────────────────────────────────────────────────
# From developer.paypal.com → Apps & Credentials (a REST app).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# `sandbox` (the default) to try it, `live` to take real money.
PAYPAL_ENV=sandbox
# The id of the webhook you add on that app for
# https://<your-site>/api/payments/paypal/webhook (events:
# CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED). Without it the shop
# still works, but a buyer who closes the tab before returning from PayPal
# is not charged or recorded.
PAYPAL_WEBHOOK_ID=

# ── Order now, pay by arrangement (optional) ────────────────────────────
# No payment provider needed: the buyer leaves a name and a phone, you call,
# and the money moves by bit, a transfer or cash. Works beside Stripe/PayPal,
# or alone. Empty = off.
ARRANGED_PAYMENT=
# Your WhatsApp number with the country code, for the thank-you page's button.
SHOP_WHATSAPP=
# Hours an uncollected order waits before it lapses (1–720; empty = 72).
ARRANGED_EXPIRES_HOURS=

# ── The shop ────────────────────────────────────────────────────────────
# Your site's public address, used for the payment pages' return links. On Vercel it
# falls back to the deployment's own URL.
SHOP_SITE_URL=
# Countries a parcel may be sent to (ISO, comma-separated).
SHOP_SHIPPING_COUNTRIES=IL
